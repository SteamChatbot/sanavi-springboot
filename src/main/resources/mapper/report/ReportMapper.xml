<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sanavi.backend.report.mapper.ReportMapper">

    <insert id="insertReport" parameterType="com.sanavi.backend.report.dto.Report">
        INSERT INTO report (
            reported_user_id,
            report_user_id,
            category,
            detail,
            created_at
        ) VALUES (
            #{reportedUserId},
            #{reportUserId},
            #{category},
            #{detail},
            #{createdAt}
        )
    </insert>

</mapper>
